{
  "name": "jimfolio-monorepo",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "dev:jimfolio:3100": "cd apps/jimfolio && npm run dev -- -p 3100",
    "dev:wesplit:3110": "cd apps/wesplit && npm run dev -- -p 3110",
    "start:wesplit:3110": "cd apps/wesplit && npm run start -- -p 3110",
    "lint": "turbo run lint",
    "postinstall": "npm run postinstall --workspaces --if-present",
    "clean": "turbo run clean",
    "format": "prettier --write \"**/*.{ts,tsx,md}\""
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "prettier": "^3.1.0",
    "turbo": "^2.3.0",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=20.9.0",
    "npm": ">=10.0.0"
  },
  "packageManager": "npm@10.8.2"
}
