datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

model Bean {
  id        String    @id @default(cuid())
  name      String
  roaster   String?
  origin    String?
  variety   String?
  roastDate    DateTime
  notes        String?
  process      String?
  tastingNotes String?
  roastLevel   String?
  altitude     String?
  archived     Boolean   @default(false)
  createdAt    DateTime  @default(now())
  brews        BrewLog[]
}

model BrewMethod {
  id    String    @id @default(cuid())
  label String    @unique // e.g. "Espresso — Lelit Bianca", "V60 pour-over"
  brews BrewLog[]
}

model Grinder {
  id           String    @id @default(cuid())
  manufacturer String?
  model        String?
  type         String?   // FLAT_BURR | CONICAL_BURR | BLADE | OTHER (zod enum)
  notes        String?
  archived     Boolean   @default(false)
  createdAt    DateTime  @default(now())
  brews        BrewLog[]
}

model BrewLog {
  id        String     @id @default(cuid())
  beanId    String
  bean      Bean       @relation(fields: [beanId], references: [id])
  methodId  String
  method    BrewMethod @relation(fields: [methodId], references: [id])
  brewDate  DateTime   @default(now())
  grindSize String?    // legacy free text: "12 clicks", "3.5" — old rows only
  grinder   String?    // legacy free text — old rows only; linked rows use grinderRef
  grinderId String?
  grinderRef Grinder?  @relation(fields: [grinderId], references: [id])
  grindSetting Float?
  rating    Int?       // 1–5
  notes     String?
  doseG      Float?
  yieldG     Float?
  brewTimeSec Int?
  createdAt DateTime   @default(now())
}
